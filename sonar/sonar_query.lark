start: probe
probe: probe_line NL target_line (NL must_line)? (NL must_line)? (NL should_line)? (NL should_line)? (NL must_not_line)? (NL must_not_line)? (NL time_line)? (NL limit_line)? NL?
probe_line: "PROBE" SP MODE
target_line: "TARGET" SP QUOTED
must_line: "MUST" SP QUOTED
should_line: "SHOULD" SP QUOTED
must_not_line: "MUST_NOT" SP QUOTED
time_line: "TIME" SP QUOTED
limit_line: "LIMIT" SP LIMIT_VALUE

MODE: "LITERAL" | "SEMANTIC" | "FUNCTIONAL" | "RELATIONAL"
QUOTED: /"[^"\\n]{1,240}"/
LIMIT_VALUE: /10|[1-9]/
SP: " "
NL: /\\r?\\n/
