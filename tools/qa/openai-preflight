#!/usr/bin/env python3
from __future__ import annotations

import hashlib
import json
from pathlib import Path
import subprocess
import sys
import tempfile
import zipfile

from jsonschema import Draft202012Validator
import yaml

ROOT = Path(__file__).resolve().parents[2]
LOCK_PATH = ROOT / "QA" / "openai-preflight.lock.json"
SKILL_VALIDATOR = ROOT / "third_party" / "openai" / "quick_validate.py"
PLUGIN_SCHEMA = ROOT / "third_party" / "agent-plugins" / "plugin.schema.json"
CANONICAL_SKILL_DIR = ROOT / ".agents" / "skills" / "sonar"
SOURCE_MANIFEST = ROOT / "packaging" / "sonar" / "plugin.json"
OPENAI_AGENT = ROOT / ".agents" / "skills" / "sonar" / "agents" / "openai.yaml"


def sha256_bytes(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def git_blob_sha(data: bytes) -> str:
    header = f"blob {len(data)}\0".encode("ascii")
    return hashlib.sha1(header + data).hexdigest()


def verify_locked_file(path: Path, entry: dict[str, str]) -> bytes:
    data = path.read_bytes()
    expected_sha256 = entry["sha256"]
    expected_blob = entry["git_blob_sha"]

    actual_sha256 = sha256_bytes(data)
    actual_blob = git_blob_sha(data)

    if actual_sha256 != expected_sha256:
        raise SystemExit(
            f"{path}: sha256 mismatch: {actual_sha256} != {expected_sha256}"
        )
    if actual_blob != expected_blob:
        raise SystemExit(
            f"{path}: git blob mismatch: {actual_blob} != {expected_blob}"
        )
    return data


def run_skill_validator(skill_dir: Path) -> None:
    proc = subprocess.run(
        [sys.executable, str(SKILL_VALIDATOR), str(skill_dir)],
        cwd=ROOT,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    if proc.stdout:
        print(proc.stdout.rstrip())
    if proc.stderr:
        print(proc.stderr.rstrip(), file=sys.stderr)
    if proc.returncode != 0:
        raise SystemExit(
            f"OpenAI quick_validate.py failed for {skill_dir} "
            f"with exit {proc.returncode}"
        )


def load_schema(schema_bytes: bytes) -> dict:
    schema = json.loads(schema_bytes.decode("utf-8"))
    Draft202012Validator.check_schema(schema)
    return schema


def validate_manifest(path: Path, schema: dict) -> None:
    manifest = json.loads(path.read_text(encoding="utf-8"))
    Draft202012Validator(schema).validate(manifest)


def validate_openai_agent(path: Path) -> None:
    value = yaml.safe_load(path.read_text(encoding="utf-8"))
    if type(value) is not dict:
        raise SystemExit("agents/openai.yaml must contain a mapping")
    interface = value.get("interface")
    if type(interface) is not dict:
        raise SystemExit("agents/openai.yaml interface must be a mapping")
    if interface.get("display_name") != "Sonar":
        raise SystemExit("agents/openai.yaml display_name must be Sonar")
    short = interface.get("short_description")
    if type(short) is not str or not short.strip():
        raise SystemExit("agents/openai.yaml short_description must be non-empty")
    policy = value.get("policy")
    if type(policy) is not dict:
        raise SystemExit("agents/openai.yaml policy must be a mapping")
    if policy.get("allow_implicit_invocation") is not True:
        raise SystemExit("Sonar must explicitly allow implicit invocation")


def main() -> int:
    lock = json.loads(LOCK_PATH.read_text(encoding="utf-8"))

    verify_locked_file(
        SKILL_VALIDATOR,
        lock["openai_skill_validator"],
    )
    schema_bytes = verify_locked_file(
        PLUGIN_SCHEMA,
        lock["agent_plugins_schema"],
    )
    schema = load_schema(schema_bytes)

    run_skill_validator(CANONICAL_SKILL_DIR)
    validate_manifest(SOURCE_MANIFEST, schema)
    validate_openai_agent(OPENAI_AGENT)

    with tempfile.TemporaryDirectory() as tmp:
        tmp_path = Path(tmp)
        archive = tmp_path / "sonar-plugin.zip"
        subprocess.run(
            [
                sys.executable,
                str(ROOT / "tools" / "package-plugin"),
                "--out",
                str(archive),
            ],
            cwd=ROOT,
            check=True,
        )

        unpacked = tmp_path / "unpacked"
        with zipfile.ZipFile(archive) as zf:
            zf.extractall(unpacked)

        plugin_root = unpacked / "sonar"
        run_skill_validator(plugin_root / "skills" / "sonar")
        validate_manifest(plugin_root / "plugin.json", schema)
        validate_openai_agent(
            plugin_root / "skills" / "sonar" / "agents" / "openai.yaml"
        )

    print("OPENAI_PREFLIGHT_PASS")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
