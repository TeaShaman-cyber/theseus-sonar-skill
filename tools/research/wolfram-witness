#!/usr/bin/env python3
from __future__ import annotations

import argparse
import hashlib
import json
import pathlib
import re
import subprocess
import sys
import tempfile


ROOT = pathlib.Path(__file__).resolve().parents[2]
WITNESS_TEMPLATE = ROOT / "QA" / "wolfram" / "sonar-decision.wl"
DECISION_SOURCE = ROOT / "scripts" / "sonar_decision.py"
STATE_COUNT = 16384

sys.path.insert(0, str(ROOT))

from scripts.sonar_decision import (
    Evidence,
    NavigationState,
    NextAction,
    ProbeMode,
    Receipt,
    decide_navigation,
)


def sha256_bytes(value: bytes) -> str:
    return hashlib.sha256(value).hexdigest()


def build_python_outcomes() -> str:
    modes = tuple(ProbeMode)
    outcomes: list[str] = []

    for budget in range(4):
        for state_bits in range(1 << (3 * len(modes))):
            receipts: list[Receipt] = []
            for index, mode in enumerate(modes):
                bits = (state_bits >> (3 * index)) & 0b111
                if bits & 0b001:
                    receipts.append(Receipt(mode, Evidence.STRONG))
                if bits & 0b010:
                    receipts.append(Receipt(mode, Evidence.DRIFT))
                if bits & 0b100:
                    receipts.append(Receipt(mode, Evidence.CONFLICT))

            decision = decide_navigation(tuple(receipts), remaining_budget=budget)
            key = (decision.state, decision.next_action)
            if key == (
                NavigationState.LOCATED,
                NextAction.RESOLVE_AUTHORITY,
            ):
                outcomes.append("L")
            elif key == (
                NavigationState.UNLOCATED,
                NextAction.PROBE_PERSONAL_CONTEXT_SEARCH,
            ):
                outcomes.append("P")
            elif key == (NavigationState.UNKNOWN, NextAction.NONE):
                outcomes.append("U")
            else:
                raise RuntimeError(f"unexpected navigation decision: {decision}")

    result = "".join(outcomes)
    if len(result) != STATE_COUNT:
        raise RuntimeError(f"unexpected behavior table size: {len(result)}")
    return result


def render_wolfram_program(
    outcomes: str,
    table_sha256: str,
    decision_source_sha256: str,
) -> str:
    template = WITNESS_TEMPLATE.read_text(encoding="utf-8")
    replacements = {
        "__PYTHON_OUTCOMES__": outcomes,
        "__PYTHON_TABLE_SHA256__": table_sha256,
        "__DECISION_SOURCE_SHA256__": decision_source_sha256,
    }
    for placeholder, value in replacements.items():
        if placeholder not in template:
            raise RuntimeError(f"missing witness placeholder: {placeholder}")
        template = template.replace(placeholder, value)
    return template


def parse_wolfram_payload(raw: str):
    for line in raw.splitlines():
        match = re.match(r"^\s*Out\[\d+\]\s*=\s*(.+?)\s*$", line)
        if not match:
            continue
        try:
            value = json.loads(match.group(1))
            if isinstance(value, str):
                value = json.loads(value)
            if isinstance(value, dict):
                return value
        except Exception:
            pass

    match = re.search(r'\{\s*".*?"\}', raw, re.S)
    if match:
        try:
            value = json.loads(match.group(0))
            if isinstance(value, dict):
                return value
        except Exception:
            pass
    return None


def run_process(command, timeout_seconds: float):
    try:
        return subprocess.run(
            command,
            text=True,
            capture_output=True,
            timeout=timeout_seconds,
        )
    except subprocess.TimeoutExpired as exc:
        stdout = exc.stdout or ""
        stderr = exc.stderr or ""
        if isinstance(stdout, bytes):
            stdout = stdout.decode("utf-8", errors="replace")
        if isinstance(stderr, bytes):
            stderr = stderr.decode("utf-8", errors="replace")
        return subprocess.CompletedProcess(
            command,
            124,
            stdout,
            f"{stderr}\nTimeoutExpired after {timeout_seconds}s".strip(),
        )
    except (FileNotFoundError, PermissionError, OSError) as exc:
        return subprocess.CompletedProcess(
            command,
            127,
            "",
            f"{type(exc).__name__}: {exc}",
        )


def expected_payload(table_sha256: str, decision_source_sha256: str) -> dict:
    return {
        "state_count": STATE_COUNT,
        "implementation_match": True,
        "mismatch_count": 0,
        "unsafe_conflict_located": 0,
        "unsafe_drift_located": 0,
        "located_without_independent_strong": 0,
        "located_without_discriminating_strong": 0,
        "probe_at_zero": 0,
        "located_reachable": True,
        "probe_reachable": True,
        "unknown_reachable": True,
        "python_table_sha256": table_sha256,
        "decision_source_sha256": decision_source_sha256,
        "pass": True,
    }


def payload_has_expected_schema(payload: dict, expected: dict) -> bool:
    if set(payload) != set(expected):
        return False
    return all(type(payload[key]) is type(value) for key, value in expected.items())


def classify(returncode: int, payload, expected: dict) -> str:
    if returncode != 0 or not isinstance(payload, dict):
        return "DEGRADED_EXTERNAL_WITNESS"
    if not payload_has_expected_schema(payload, expected):
        return "DEGRADED_EXTERNAL_WITNESS"

    if (
        payload["python_table_sha256"] != expected["python_table_sha256"]
        or payload["decision_source_sha256"] != expected["decision_source_sha256"]
    ):
        return "DEGRADED_EXTERNAL_WITNESS"

    if payload == expected:
        return "VERIFIED"
    return "FAIL_ASSERTION"


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--out", type=pathlib.Path, required=True)
    parser.add_argument(
        "--mcporter",
        default="/workspace/tools/mcporter/bin/mcporter",
    )
    parser.add_argument("--client-timeout", type=float, default=75.0)
    args = parser.parse_args()

    if args.client_timeout <= 0:
        raise SystemExit("--client-timeout must be positive")
    if not WITNESS_TEMPLATE.is_file():
        raise SystemExit(f"missing Wolfram witness: {WITNESS_TEMPLATE}")
    if not DECISION_SOURCE.is_file():
        raise SystemExit(f"missing decision source: {DECISION_SOURCE}")

    outcomes = build_python_outcomes()
    table_sha256 = sha256_bytes(outcomes.encode("ascii"))
    decision_source_sha256 = sha256_bytes(DECISION_SOURCE.read_bytes())
    program = render_wolfram_program(
        outcomes,
        table_sha256,
        decision_source_sha256,
    )
    expected = expected_payload(table_sha256, decision_source_sha256)

    with tempfile.TemporaryDirectory(prefix="sonar-wolfram-") as tmpdir:
        generated = pathlib.Path(tmpdir) / "sonar-decision-generated.wl"
        generated.write_text(program, encoding="utf-8")
        generated_sha256 = sha256_bytes(generated.read_bytes())

        proc = run_process(
            [
                args.mcporter,
                "call",
                "wolfram.WolframLanguageEvaluator",
                f"code=@{generated}",
                "timeConstraint=60",
            ],
            args.client_timeout,
        )

    raw = (proc.stdout + "\n" + proc.stderr).strip()
    payload = parse_wolfram_payload(raw)
    status = classify(proc.returncode, payload, expected)

    version_proc = run_process(
        [args.mcporter, "--version"],
        min(args.client_timeout, 5.0),
    )
    version = (
        version_proc.stdout.strip()
        if version_proc.returncode == 0
        else "UNAVAILABLE"
    )

    receipt = {
        "schema": "theseus.sonar-wolfram-witness.v2",
        "witness_template_sha256": sha256_bytes(WITNESS_TEMPLATE.read_bytes()),
        "witness_sha256": generated_sha256,
        "decision_source_sha256": decision_source_sha256,
        "python_table_sha256": table_sha256,
        "mcporter_version": version,
        "transport": {
            "client": "mcporter",
            "server": "wolfram",
            "tool": "WolframLanguageEvaluator",
            "command_shape": "generated-code=@file",
            "returncode": proc.returncode,
            "client_timeout_seconds": args.client_timeout,
        },
        "status": status,
        "payload": payload,
        "raw_excerpt": raw[:2000],
    }

    args.out.parent.mkdir(parents=True, exist_ok=True)
    args.out.write_text(
        json.dumps(receipt, indent=2, sort_keys=True) + "\n",
        encoding="utf-8",
    )

    print(json.dumps(receipt, sort_keys=True, separators=(",", ":")))
    return {
        "VERIFIED": 0,
        "FAIL_ASSERTION": 1,
        "DEGRADED_EXTERNAL_WITNESS": 2,
    }[status]


if __name__ == "__main__":
    raise SystemExit(main())
