#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
from pathlib import Path
import re
import zipfile

ROOT = Path(__file__).resolve().parents[1]
MANIFEST = ROOT / "packaging" / "sonar" / "plugin.json"
SKILL = ROOT / ".agents" / "skills" / "sonar" / "SKILL.md"
ROOT_NAME = "sonar"
EXPECTED_FILES = (
    f"{ROOT_NAME}/plugin.json",
    f"{ROOT_NAME}/skills/sonar/SKILL.md",
)


def validate_manifest(manifest: dict) -> None:
    if manifest.get("$schema") != "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json":
        raise SystemExit("unexpected plugin schema")
    if manifest.get("name") != ROOT_NAME:
        raise SystemExit("plugin name must be sonar")
    version = manifest.get("version")
    if type(version) is not str or not re.fullmatch(r"[0-9]+\.[0-9]+\.[0-9]+", version):
        raise SystemExit("plugin version must be strict semver")
    interface = manifest["extensions"]["com.openai"]["interface"]
    short = interface["shortDescription"]
    if type(short) is not str or len(short) > 30:
        raise SystemExit("shortDescription must be at most 30 characters")


def validate_skill(skill: str) -> None:
    parts = skill.split("---", 2)
    if len(parts) != 3:
        raise SystemExit("SKILL.md must contain YAML frontmatter")
    frontmatter = parts[1]
    if "\nname: sonar\n" not in f"\n{frontmatter}\n":
        raise SystemExit("SKILL.md frontmatter name must be sonar")
    if "\ndescription: Use when " not in f"\n{frontmatter}\n":
        raise SystemExit("SKILL.md description must use the trigger contract")


def write_entry(zf: zipfile.ZipFile, path: str, content: bytes) -> None:
    info = zipfile.ZipInfo(path, date_time=(1980, 1, 1, 0, 0, 0))
    info.compress_type = zipfile.ZIP_DEFLATED
    info.external_attr = 0o100644 << 16
    zf.writestr(info, content)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--out", type=Path, required=True)
    args = parser.parse_args()

    manifest = json.loads(MANIFEST.read_text(encoding="utf-8"))
    skill = SKILL.read_text(encoding="utf-8")
    validate_manifest(manifest)
    validate_skill(skill)

    args.out.parent.mkdir(parents=True, exist_ok=True)
    with zipfile.ZipFile(args.out, "w") as zf:
        write_entry(
            zf,
            EXPECTED_FILES[0],
            (json.dumps(manifest, indent=2, ensure_ascii=False) + "\n").encode("utf-8"),
        )
        write_entry(zf, EXPECTED_FILES[1], skill.encode("utf-8"))

    with zipfile.ZipFile(args.out, "r") as zf:
        names = tuple(zf.namelist())
        if names != EXPECTED_FILES:
            raise SystemExit(f"unexpected archive contents: {names}")

    print(f"PLUGIN_PACKAGE_PASS {args.out}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
