#!/bin/sh
set -u

ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || {
    printf '%s\n' 'mutation-test: not inside a Git worktree' >&2
    exit 2
}
cd "$ROOT" || exit 2

RECEIPT=${MUTATION_TEST_RECEIPT:-${RUNNER_TEMP:-/tmp}/mutation-test-receipt.json}
TMP_BASE=${RUNNER_TEMP:-/tmp}
WORK_DIR=$(mktemp -d "$TMP_BASE/mutation-test.XXXXXX") || exit 2
SOURCE_SHA=$(git rev-parse HEAD) || exit 2
export SOURCE_SHA RECEIPT
MUTMUT_RUN_EXIT=0
export MUTMUT_RUN_EXIT
cleanup() {
    rm -rf "$WORK_DIR"
}
trap cleanup EXIT
trap 'cleanup; exit 130' INT
trap 'cleanup; exit 143' TERM

git archive HEAD | tar -x -C "$WORK_DIR" || exit 2
cp "$ROOT/tools/ci/mutation-decision.cfg" "$WORK_DIR/setup.cfg" || exit 2
cd "$WORK_DIR" || exit 2

set +e
mutmut run --max-children 2 >mutmut-run.log 2>&1
run_code=$?
MUTMUT_RUN_EXIT=$run_code
export MUTMUT_RUN_EXIT
mutmut export-cicd-stats >mutmut-export.log 2>&1
export_code=$?
mutmut results >mutmut-survivors.log 2>&1
results_code=$?
first_survivor=$(sed -n 's/^[[:space:]]*\([^:][^:]*\): survived$/\1/p' mutmut-survivors.log | head -n 1)
if [ -n "$first_survivor" ]; then
    mutmut show "$first_survivor" >mutmut-first-survivor.log 2>&1
fi
second_survivor=$(sed -n 's/^[[:space:]]*\([^:][^:]*\): survived$/\1/p' mutmut-survivors.log | sed -n '2p')
if [ -n "$second_survivor" ]; then
    mutmut show "$second_survivor" >mutmut-second-survivor.log 2>&1
fi
set -e

if [ "$export_code" -ne 0 ] || [ ! -f mutants/mutmut-cicd-stats.json ]; then
    python - <<'PY'
import json, os
from pathlib import Path
receipt={
    "schema_version":1,
    "status":"MUTATION_RUNTIME_FAILED",
    "source_sha":os.environ["SOURCE_SHA"],
    "engine":{"name":"mutmut","version":"3.8.0"},
    "error":"mutmut CI stats export failed or receipt was missing",
}
Path(os.environ["RECEIPT"]).write_text(json.dumps(receipt,indent=2,sort_keys=True)+"\n")
PY
    cat mutmut-run.log >&2 || true
    cat mutmut-export.log >&2 || true
    exit 2
fi

python - <<'PY'
import json, os
from pathlib import Path
stats=json.loads(Path("mutants/mutmut-cicd-stats.json").read_text())
incomplete_keys=("no_tests","suspicious","timeout","check_was_interrupted_by_user","segfault")
terminal_keys=("killed","survived","no_tests","suspicious","timeout","segfault","skipped")
total=int(stats.get("total",0))
classified=sum(int(stats.get(key,0)) for key in terminal_keys)
if any(int(stats.get(key,0)) for key in incomplete_keys) or classified != total:
    status="MUTATION_INCOMPLETE"
    code=2
elif int(stats.get("survived",0)):
    status="SURVIVORS_PRESENT"
    code=1
else:
    status="MUTATION_CLEAN"
    code=0
receipt={
    "schema_version":1,
    "status":status,
    "source_sha":os.environ["SOURCE_SHA"],
    "engine":{"name":"mutmut","version":"3.8.0"},
    "profile":"sonar_decision_boundary",
    "scope":{
        "only_mutate":"scripts/sonar_decision.py",
        "tests":"tests/test_sonar_decision.py"
    },
    "mutmut_run_exit":int(os.environ.get("MUTMUT_RUN_EXIT","0")),
    "classified_mutants":classified,
    "unclassified_mutants":max(total-classified,0),
    "stats":stats,
}
if status == "MUTATION_INCOMPLETE":
    log_path=Path("mutmut-run.log")
    if log_path.exists():
        receipt["run_log_tail"]=log_path.read_text(errors="replace")[-4000:]
if int(stats.get("survived", 0)):
    survivor_path=Path("mutmut-survivors.log")
    if survivor_path.exists():
        survivor_text=survivor_path.read_text(errors="replace")
        receipt["survivor_excerpt"]=survivor_text[:12000]
        survivor_ids=[
            line.strip()[:-len(": survived")]
            for line in survivor_text.splitlines()
            if line.strip().endswith(": survived")
        ]
        receipt["survivor_ids"]=survivor_ids
        if survivor_ids:
            receipt["first_survivor"]=survivor_ids[0]
    diff_path=Path("mutmut-first-survivor.log")
    if diff_path.exists():
        receipt["first_survivor_diff"]=diff_path.read_text(errors="replace")[:12000]
    if len(survivor_ids) > 1:
        receipt["second_survivor"]=survivor_ids[1]
    second_diff_path=Path("mutmut-second-survivor.log")
    if second_diff_path.exists():
        receipt["second_survivor_diff"]=second_diff_path.read_text(errors="replace")[:12000]
Path(os.environ["RECEIPT"]).write_text(json.dumps(receipt,indent=2,sort_keys=True)+"\n")
print(f"MUTATION_TEST_STATUS {status}")
print("MUTATION_TEST_STATS " + " ".join(
    f"{k}={stats.get(k,0)}"
    for k in ("total","killed","survived","no_tests","suspicious","timeout","segfault")
))
raise SystemExit(code)
PY
